PORT=3000
DATA_SOURCE=memory

# Set DATA_SOURCE=postgres and provide a connection string to use PostGIS.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_queue
DATABASE_SSL=false
DEMO_USER_ID=1

# Optional token for server-to-server GIS tools (do not expose to the browser).
GIS_TOOLS_TOKEN=
AGENT_SERVICE_URL=
AGENT_API_TOKEN=
